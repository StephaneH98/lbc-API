# ==========================================
# Lambda Functions - Global .gitignore
# ==========================================

# Packages de déploiement
*.zip
function.zip

# Dossiers de build temporaires
build_temp/
build/
dist/

# Dépendances Python
# Ces bibliothèques doivent être installées dans build_temp/, pas dans le repo
boto3/
botocore/
beautifulsoup4/
bs4/
soupsieve/
certifi/
charset_normalizer/
dateutil/
idna/
jmespath/
python_dateutil-*.dist-info/
requests/
s3transfer/
six.py
urllib3/
*.dist-info/
*.egg-info/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
env/
ENV/
.venv/

# Node.js
node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
.AppleDouble
.LSOverride

# Logs
*.log
logs/

# AWS SAM
.aws-sam/
samconfig.toml

# Tests
.pytest_cache/
.coverage
htmlcov/

# Environment variables
.env
.env.local
.env.*.local
